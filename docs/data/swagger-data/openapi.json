{
  "openapi": "3.1.0",
  "info": {
    "title": "FlavorTrends · API Data",
    "description": "Tendances d'arômes calculées sur données réelles (Google Trends, Open Food Facts, presse, réseaux, Wikipédia). V1 = règle simple « gros pic = buzz » (premier résultat). V2 = régression logistique validée en leave-one-flavor-out (modèle du prototype). MiroFish : simulation séparée, null tant qu'aucune simulation n'a été exécutée.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "État de l'API et date des données",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/trends": {
      "get": {
        "summary": "Liste des arômes (dashboard et supermarché 3D)",
        "operationId": "list_trends_api_v1_trends_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "include_series",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Series"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trends/{trend_id}": {
      "get": {
        "summary": "Fiche complète d'un arôme (rapport détaillé)",
        "operationId": "get_trend_api_v1_trends__trend_id__get",
        "parameters": [
          {
            "name": "trend_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trend Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trends/{trend_id}/packet": {
      "get": {
        "summary": "Fiche Markdown prête pour MiroFish",
        "operationId": "get_packet_api_v1_trends__trend_id__packet_get",
        "parameters": [
          {
            "name": "trend_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trend Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/model-metrics": {
      "get": {
        "summary": "Validation du modèle V2, comparé à V1 (matrice de confusion, F1, comparaisons)",
        "operationId": "model_metrics_api_v1_model_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/simulate": {
      "post": {
        "summary": "Probabilité V2 qu'une hausse soit durable, pour des variables données",
        "operationId": "simulate_api_v1_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SimulationRequest": {
        "properties": {
          "croissance_13s": {
            "type": "number",
            "title": "Croissance 13S",
            "description": "croissance sur 13 semaines (0.45 = +45 %)",
            "default": 0.45
          },
          "croissance_52s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Croissance 52S",
            "description": "vs la même période l'an dernier",
            "default": 0.3
          },
          "volatilite_26s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volatilite 26S",
            "description": "écart-type / moyenne sur 26 semaines",
            "default": 0.25
          },
          "pic_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pic Ratio",
            "description": "pic des 13 dernières semaines / moyenne sur 26",
            "default": 1.4
          },
          "acceleration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acceleration",
            "description": "moyenne 4 semaines / moyenne 13 semaines",
            "default": 1.1
          },
          "popularite_vs_ancre": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Popularite Vs Ancre",
            "description": "niveau de recherche / vanille",
            "default": 0.2
          },
          "produits_marche": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Produits Marche",
            "description": "log(1 + nombre de produits en rayon)",
            "default": 3.0
          }
        },
        "type": "object",
        "title": "SimulationRequest",
        "description": "Variables d'un arôme EN HAUSSE (mêmes définitions que les cas de référence)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
