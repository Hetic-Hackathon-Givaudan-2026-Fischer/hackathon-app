{
  "name": "hackathon",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev:api\" \"npm run dev -w web\"",
    "dev:api": "uv run --locked --directory api uvicorn app.main:app --reload --reload-dir app --port 3000",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write . '!db/data'",
    "format:check": "prettier --check . '!db/data'",
    "prepare": "husky || true",
    "gen:api": "openapi-typescript openapi.yaml -o web/src/api/schema.d.ts && prettier --write web/src/api/schema.d.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write",
    "*.py": [
      "uv run --frozen --project api ruff check --fix",
      "uv run --frozen --project api ruff format"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
