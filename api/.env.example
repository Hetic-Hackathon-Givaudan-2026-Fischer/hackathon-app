# Copié en api/.env à la création du conteneur. Le .env n'est jamais commité.
# postgres:// suffit : l'API choisit elle-même le pilote async (asyncpg)
DATABASE_URL=postgres://app:app@db:5432/app

# API de l'équipe Data/IA (tendances d'arômes, ADR 0008). Vide : CSV de repli seul.
# Renseignée : tendances lues chez Data/IA, CSV si elle ne répond pas.
DATA_AI_URL=
DATA_AI_KEY=
# Au-delà (en secondes), Data/IA est jugée injoignable et le CSV prend le relais
DATA_AI_TIMEOUT_SECONDS=5

# Liens showroom (ADR 0010) : URL du front dans les liens, durée de vie par défaut
PUBLIC_WEB_URL=http://localhost:5173
SHOWROOM_LINK_TTL_HOURS=72
