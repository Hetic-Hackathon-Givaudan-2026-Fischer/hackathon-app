// Réglages Zed du projet : l'équivalent de customizations.vscode.settings
// dans .devcontainer/devcontainer.json (Zed n'y lit que les extensions).
{
  // "editor.formatOnSave": true
  "format_on_save": "on",

  // "editor.defaultFormatter": Prettier. En mode "auto", Zed formate avec Prettier
  "formatter": "auto",

  // "source.fixAll.eslint" : ESLint corrige puis Prettier formate
  "languages": {
    "JavaScript": {
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "TypeScript": {
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "TSX": { "code_actions_on_format": { "source.fixAll.eslint": true } },
    // Python : Ruff (intégré à Zed) formate, corrige et trie les imports,
    // comme le bloc "[python]" de devcontainer.json pour VS Code
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      }
    }
  }
}
